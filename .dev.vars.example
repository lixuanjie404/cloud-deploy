# 本地调试用：复制为 .dev.vars（该文件已被 .gitignore 忽略）
#
# 一、Hyperdrive 本地模拟（wrangler 4.20.5 起，wrangler dev 强制要求）
#   wrangler 会校验 WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
#   （末尾 HYPERDRIVE = wrangler.jsonc 里的 binding 名）。报错里的 "Postgres"
#   是通用文案，本项目用 mysql:// 连接串即可，不用真的装 Postgres。
#
#   注意：这个变量是 wrangler 进程自己读的，只认 shell 环境变量或 .env；
#   写在 .dev.vars 里不会生效（.dev.vars 只注入 Worker 运行时）。
#   所以推荐直接用 `npm run dev`：scripts/wrangler-dev.mjs 会拿下面的
#   MYSQL_*（或 DB_*）自动拼成 mysql:// 连接串并注入，无需手填、无需提交口令。
#
#   若坚持直接跑 `npx wrangler dev`，两种方式二选一：
#     a) 在 .env 里写完整连接串（.env 同样被 .gitignore 忽略）：
#        WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="mysql://user:pass@host:3306/db"
#     b) 在 wrangler.jsonc 的 hyperdrive 段加 "localConnectionString"（含明文口令，不建议提交）
#   新版 wrangler 也接受 CLOUDFLARE_ 前缀，本项目锁定的 4.20.5 只认 WRANGLER_ 前缀。
#   `wrangler dev --remote` 走云端 Hyperdrive，不需要这个变量。
#
# 二、数据库直连回退（不启用 Hyperdrive 时，db.js / kline.js 使用）
#   db.js 读 DB_*；kline.js 兼容 DB_* 与 MYSQL_*。
#   下面是占位值，请复制为 .dev.vars 后填真实值，切勿把口令提交进仓库。

MYSQL_HOST=db.example.com
MYSQL_PORT=3306
MYSQL_USERNAME=app_ro
MYSQL_PASSWORD=
MYSQL_DATABASE=market

# db.js 的直连参数（与上面等价，二选一即可）
# DB_HOST=db.example.com
# DB_PORT=3306
# DB_USER=app_ro
# DB_PASSWORD=
# DB_NAME=market
# DB_SSL=on

# 可选白名单：只允许读取这些表，逗号分隔；留空表示可读全库（不建议）
DB_TABLES=
