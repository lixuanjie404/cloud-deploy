# 本地调试用：复制为 .dev.vars（该文件已被 .gitignore 忽略）
#
# 启用 Hyperdrive 时，本地默认读 wrangler.jsonc 里的 localConnectionString；
# 也可以用环境变量覆盖（优先级更高）：
#   CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
#
# 下面的 DB_* 只在不启用 Hyperdrive、直接连库时才需要填。

DB_HOST=db.example.com
DB_PORT=3306
DB_USER=app_ro
DB_PASSWORD=
DB_NAME=market

# 数据库要求 TLS 时设为 on（Hyperdrive 本身强制 TLS，直连也建议开）
DB_SSL=on

# 可选白名单：只允许读取这些表，逗号分隔；留空表示可读全库（不建议）
DB_TABLES=
